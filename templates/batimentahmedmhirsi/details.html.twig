{% extends 'base.html.twig' %}

{% block title %}Author Details{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1> {{ title }} </h1>
    <div>
    <div>
    {% if batiment is not null %}
        <p><b>nom : </b> {{ batiment.nom }} </p>
       <p><b>nombre etages : </b> {{ batiment.nbetage }} </p>
        <p><b>available: </b> {{ batiment.available }} </p>
        <p><b>date: </b> {{ batiment.dateconstruction | date('d-m-Y') }} </p>
        </div><hr>
    {% else %}
        <p>Author not found.</p>
    {% endif %}
    <a href="{{ path('app_batiment_list') }}" >Return to List</a>
    </div>
    
</div>
{% endblock %}
